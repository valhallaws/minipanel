APP_NAME=Freyja
APP_ENV=production
# Genera antes de instalar: php -r 'echo "base64:".base64_encode(random_bytes(32)).PHP_EOL;'
APP_KEY=
APP_DEBUG=false
APP_URL=https://panel.ejemplo.com

# Genera un valor aleatorio permanente (32+ caracteres) antes de registrar una passkey.
# Ejemplo: php -r 'echo bin2hex(random_bytes(32)).PHP_EOL;'
PASSKEYS_USER_HANDLE_SECRET=
# Se usa exclusivamente para validar el webhook de actualización del panel en GitHub.
# Ejemplo: openssl rand -hex 32
PANEL_UPDATE_WEBHOOK_SECRET=
PANEL_UPDATE_BRANCH=main
MINIPANEL_EXECUTION_ENABLED=false
MINIPANEL_FILE_TRANSFER_MAX_KB=2097152
MINIPANEL_FILE_UPLOAD_MAX_TIME=120
MINIPANEL_DOWNLOAD_PATH=/var/lib/minipanel/downloads

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=minipanel
DB_USERNAME=minipanel_app
DB_PASSWORD=REEMPLAZA_CON_CONTRASENA_LARGA

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS=panel@ejemplo.com
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
