#!/usr/bin/env bash
# Install as /usr/local/bin/minipanel-agent (root:root, 0750).
# This is deliberately an allow-list. Never accept a shell command from the panel.
set -euo pipefail

action="${1:-}"; site_root="${2:-}"; domain="${3:-}"; repository="${4:-}"
branch="${5:-main}"; php_version="${6:-8.3}"; queue_enabled="${7:-0}"; scheduler_enabled="${8:-1}"; runtime="${9:-laravel}"; php_extensions="${10:-}"
extra_arguments=("${@:11}")
legacy_site_user="mp_${domain//./_}"
site_user="$legacy_site_user"
site_user_directory='/etc/minipanel/site-users'
site_user_file="$site_user_directory/$domain"
nginx_file="/etc/nginx/sites-available/${domain}"
service_file="/etc/systemd/system/minipanel-${domain}.service"
timer_file="/etc/systemd/system/minipanel-${domain}.timer"
key_directory="/etc/minipanel/deploy-keys"
key_file="$key_directory/$domain"
alias_file="/etc/minipanel/aliases/$domain"
nginx_snippet="/etc/nginx/snippets/minipanel-${domain}.conf"
node_version_file="/etc/minipanel/node-versions/$domain"
node_version='22'
node_binary=''
node_npm=''
panel_php_version='8.3'
panel_php_version_file='/etc/minipanel/panel-php-version'

if [[ -r "$panel_php_version_file" ]]; then
  panel_php_version="$(tr -d '[:space:]' < "$panel_php_version_file")"
fi
[[ "$panel_php_version" =~ ^8\.[0-9]{1,2}$ ]] || fail 'Invalid panel PHP version'
panel_php_service="php${panel_php_version}-fpm"

fail() { echo "$1" >&2; exit 64; }

ensure_node_runtime() {
  local version="$1" nvm_directory='/opt/minipanel/nvm'

  [[ "$version" =~ ^[1-9][0-9]$ && "$version" -ge 18 ]] || fail 'Unsupported Node.js version'
  if [[ ! -f "$nvm_directory/nvm.sh" ]]; then
    install -d -m 0755 -o root -g root /opt/minipanel
    git clone --depth 1 --branch v0.40.3 https://github.com/nvm-sh/nvm.git "$nvm_directory"
    chown -R root:root "$nvm_directory"
    chmod -R a+rX "$nvm_directory"
  fi
  export NVM_DIR="$nvm_directory"
  # shellcheck source=/dev/null
  . "$nvm_directory/nvm.sh"
  nvm install "$version" >/dev/null 2>&1
  node_binary="$(nvm which "$version")"
  [[ -x "$node_binary" ]] || fail 'Node.js runtime could not be installed'
  node_npm="$(dirname "$node_binary")/npm"
  [[ -x "$node_npm" ]] || fail 'NPM runtime is unavailable'
}

npm_as_site() {
  ensure_node_runtime "$node_version"
  sudo -u "$site_user" env "HOME=$site_root" "PUPPETEER_CACHE_DIR=$site_root/.cache/puppeteer" "$node_npm" --prefix "$site_root" "$@"
}

ensure_chrome_runtime() {
  local packages=(fonts-liberation libatk-bridge2.0-0 libatk1.0-0 libcairo2 libcups2 libdbus-1-3 libfontconfig1 libgbm1 libglib2.0-0 libgtk-3-0 libnspr4 libnss3 libpango-1.0-0 libpangocairo-1.0-0 libx11-6 libx11-xcb1 libxcb1 libxcomposite1 libxdamage1 libxext6 libxfixes3 libxkbcommon0 libxrandr2 libxrender1 libxshmfence1 libxss1 libxtst6 xdg-utils)

  if /usr/bin/apt-cache show libasound2t64 >/dev/null 2>&1; then
    packages+=(libasound2t64)
  else
    packages+=(libasound2)
  fi
  DEBIAN_FRONTEND=noninteractive /usr/bin/apt-get install -y "${packages[@]}"
}

save_node_version() {
  local version="$1"

  install -d -m 0755 -o root -g root /etc/minipanel/node-versions
  printf '%s\n' "$version" > "$node_version_file"
  chown root:root "$node_version_file"
  chmod 0644 "$node_version_file"
}

ensure_site_certificate_renewal_timer() {
  install -d -m 0700 -o root -g root /var/lib/minipanel/certbot-home
  cat > /usr/local/sbin/minipanel-site-certificates-renew <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
export HOME=/var/lib/minipanel/certbot-home
export XDG_CACHE_HOME=/var/lib/minipanel/certbot-home/.cache
exec /usr/local/bin/certbot renew --quiet --deploy-hook '/usr/bin/systemctl reload nginx'
EOF
  chmod 0750 /usr/local/sbin/minipanel-site-certificates-renew
  chown root:root /usr/local/sbin/minipanel-site-certificates-renew
  cat > /etc/systemd/system/minipanel-site-certificates.service <<'EOF'
[Unit]
Description=Renew Freyja site certificates when required

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/minipanel-site-certificates-renew
EOF
  cat > /etc/systemd/system/minipanel-site-certificates.timer <<'EOF'
[Unit]
Description=Check Freyja site certificate renewals twice daily

[Timer]
OnCalendar=*-*-* 03,15:00:00
Persistent=true
RandomizedDelaySec=15m
Unit=minipanel-site-certificates.service

[Install]
WantedBy=timers.target
EOF
  chmod 0644 /etc/systemd/system/minipanel-site-certificates.service /etc/systemd/system/minipanel-site-certificates.timer
  systemctl daemon-reload
  systemctl enable --now minipanel-site-certificates.timer
  systemctl is-active --quiet minipanel-site-certificates.timer || fail 'Site certificate renewal timer is not active'
}

run_certbot() {
  systemd-run --quiet --wait --pipe --collect --property=Type=exec --property=User=root /usr/local/bin/certbot "$@"
}
[[ $EUID -eq 0 ]] || fail 'Run through the authorized control-plane identity'
if [[ -n "${SUDO_USER:-}" ]]; then
  panel_identity="$(cat /etc/minipanel/panel-user)"
  [[ "$panel_identity" != 'www-data' && "$panel_identity" != "$site_user" && "$SUDO_USER" == "$panel_identity" ]] || fail 'Unauthorized agent caller'
fi
if [[ "$action" == 'server-status' ]]; then
  (( $# == 1 )) || fail 'This action does not accept arguments'
  printf 'Hostname\t%s\n' "$(hostnamectl --static 2>/dev/null || hostname)"
  printf 'Sistema\t%s\n' "$(. /etc/os-release; printf '%s %s' "$NAME" "$VERSION_ID")"
  printf 'Uptime\t%s\n' "$(uptime -p)"
  printf 'Hora\t%s\n' "$(date '+%Y-%m-%d %H:%M:%S %Z')"
  printf 'Zona horaria\t%s\n' "$(timedatectl show --property=Timezone --value)"
  printf 'NTP\t%s\n' "$(timedatectl show --property=NTPSynchronized --value)"
  printf 'CPU\t%s vCPU\n' "$(nproc)"
  printf 'Carga\t%s\n' "$(awk '{print $1 " · " $2 " · " $3}' /proc/loadavg)"
  printf 'Memoria\t%s\n' "$(free -h | awk '/Mem:/ {print $3 " / " $2}')"
  printf 'Memoria disponible\t%s\n' "$(free -h | awk '/Mem:/ {print $7}')"
  printf 'Disco /\t%s\n' "$(df -h / | awk 'NR==2 {print $3 " usados de " $2 " (" $5 ")"}')"
  printf 'Inodos /\t%s\n' "$(df -i / | awk 'NR==2 {print $3 " usados de " $2 " (" $5 ")"}')"
  for service in nginx "$panel_php_service" mariadb redis-server minipanel-worker minipanel-root-terminal; do
    printf 'Servicio:%s\t%s\n' "$service" "$(systemctl is-active "$service" 2>/dev/null || true)"
    printf 'ServicioPID:%s\t%s\n' "$service" "$(systemctl show "$service" --property=MainPID --value 2>/dev/null || true)"
    printf 'ServicioInicio:%s\t%s\n' "$service" "$(systemctl show "$service" --property=ActiveEnterTimestamp --value 2>/dev/null || true)"
  done
  exit 0
fi
if [[ "$action" == 'server-php-versions' ]]; then
  (( $# == 1 )) || fail 'This action does not accept arguments'
  {
    /usr/bin/apt-cache pkgnames 2>/dev/null || true
    find /usr/sbin -maxdepth 1 -type f -name 'php-fpm8.*' -printf '%f\n' 2>/dev/null || true
  } | sed -nE 's/^php([0-9]+\.[0-9]+)-fpm$/\1/p; s/^php-fpm([0-9]+\.[0-9]+)$/\1/p' | sort -Vu | while IFS= read -r version; do
    [[ "$version" =~ ^8\.[0-9]{1,2}$ ]] || continue
    state='disponible'
    [[ -x "/usr/sbin/php-fpm$version" ]] && state='instalado'
    printf '%s\t%s\n' "$version" "$state"
  done
  exit 0
fi
if [[ "$action" == 'server-node-versions' ]]; then
  (( $# == 1 )) || fail 'This action does not accept arguments'
  nvm_directory='/opt/minipanel/nvm'
  declare -A installed_node_majors=()
  if [[ -d "$nvm_directory/versions/node" ]]; then
    while IFS= read -r version; do
      [[ "$version" =~ ^v([1-9][0-9])\.[0-9]+\.[0-9]+$ ]] || continue
      installed_node_majors["${BASH_REMATCH[1]}"]=1
    done < <(find "$nvm_directory/versions/node" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null)
  fi
  remote_versions=''
  if [[ -f "$nvm_directory/nvm.sh" ]]; then
    remote_versions="$(/usr/bin/timeout 12 /bin/bash -c 'export NVM_DIR=/opt/minipanel/nvm; . "$NVM_DIR/nvm.sh"; nvm ls-remote' 2>/dev/null || true)"
  fi
  {
    printf '%s\n' "$remote_versions" | sed -nE 's/.*v([1-9][0-9])\.[0-9]+\.[0-9]+.*/\1/p'
    printf '%s\n' "${!installed_node_majors[@]}"
  } | sort -Vu | while IFS= read -r version; do
    [[ "$version" =~ ^[1-9][0-9]$ && "$version" -ge 18 ]] || continue
    state='disponible'
    [[ -n "${installed_node_majors[$version]:-}" ]] && state='instalado'
    printf '%s\t%s\n' "$version" "$state"
  done
  exit 0
fi
if [[ "$action" == 'server-security-status' ]]; then
  (( $# == 1 )) || fail 'This action does not accept arguments'
  firewall_status="$(/usr/sbin/ufw status 2>/dev/null | awk 'NR == 1 {print $2}')"
  firewall_rules="$(/usr/sbin/ufw status numbered 2>/dev/null | awk '/^[[:space:]]*\[[[:space:]]*[0-9]+\]/ {line=$0; sub(/^[[:space:]]+/, "", line); print line}' | paste -sd ';' -)"
  fail2ban_status="$(systemctl is-active fail2ban 2>/dev/null || true)"
  fail2ban_jails="$(/usr/bin/fail2ban-client status 2>/dev/null | awk -F: '/Jail list/ {gsub(/^[[:space:]]+/, "", $2); print $2}')"
  while IFS= read -r jail; do
    [[ -n "$jail" ]] || continue
    blocked_ips="$(/usr/bin/fail2ban-client status "$jail" 2>/dev/null | awk -F: '/Banned IP list/ {gsub(/^[[:space:]]+/, "", $2); print $2}')"
    printf 'Bloqueados:%s\t%s\n' "$jail" "${blocked_ips:-ninguno}"
  done < <(printf '%s\n' "$fail2ban_jails" | tr ',' '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
  ssh_port="$(/usr/sbin/sshd -T 2>/dev/null | awk '/^port / {print $2}')"
  ssh_password="$(/usr/sbin/sshd -T 2>/dev/null | awk '/^passwordauthentication / {print $2}')"
  ssh_root="$(/usr/sbin/sshd -T 2>/dev/null | awk '/^permitrootlogin / {print $2}')"
  ssh_operator="$(getent passwd 1000 | cut -d: -f1)"
  ssh_home="$(getent passwd 1000 | cut -d: -f6)"
  ssh_keys_file="$ssh_home/.ssh/authorized_keys"
  ssh_key_count="$(grep -Ec '^[^#[:space:]]' "$ssh_keys_file" 2>/dev/null || true)"
  while IFS=$'\t' read -r key_line key; do
    [[ -n "$key" ]] || continue
    key_description="$(printf '%s\n' "$key" | /usr/bin/ssh-keygen -lf - 2>/dev/null || printf 'Llave pública')"
    printf 'Llave SSH:%s\t%s\n' "$key_line" "$key_description"
  done < <(grep -n '^[^#[:space:]]' "$ssh_keys_file" 2>/dev/null | tr ':' '\t' || true)
  updates="$(/usr/bin/apt-get -s upgrade 2>/dev/null | awk '/^Inst / {count++} END {print count+0}')"
  update_state="$(systemctl is-active minipanel-system-update 2>/dev/null || true)"
  printf 'Firewall\t%s\n' "${firewall_status:-no disponible}"
  printf 'Reglas públicas\t%s\n' "${firewall_rules:-ninguna}"
  printf 'Fail2ban\t%s\n' "${fail2ban_status:-no disponible}"
  printf 'Jails Fail2ban\t%s\n' "${fail2ban_jails:-ninguna}"
  printf 'SSH puerto\t%s\n' "${ssh_port:-no disponible}"
  printf 'SSH contraseña\t%s\n' "${ssh_password:-no disponible}"
  printf 'SSH root\t%s\n' "${ssh_root:-no disponible}"
  printf 'SSH usuario\t%s\n' "${ssh_operator:-no disponible}"
  printf 'Llaves SSH\t%s\n' "${ssh_key_count:-0}"
  printf 'Actualizaciones pendientes\t%s\n' "$updates"
  printf 'Actualización del sistema\t%s\n' "${update_state:-inactiva}"
  exit 0
fi
if [[ "$action" == 'server-firewall-reload' ]]; then
  (( $# == 1 )) || fail 'This action does not accept arguments'
  /usr/sbin/ufw status | grep -q '^Status: active$' || fail 'UFW is not active'
  /usr/sbin/ufw reload
  echo 'Reglas de firewall recargadas'
  exit 0
fi
if [[ "$action" == 'server-firewall-allow' ]]; then
  (( $# == 4 )) || fail 'Port, protocol and source are required'
  port="$2"; protocol="$3"; source="$4"
  [[ "$port" =~ ^[0-9]{1,5}$ && "$port" -ge 1 && "$port" -le 65535 ]] || fail 'Invalid port'
  [[ "$protocol" =~ ^(tcp|udp)$ ]] || fail 'Invalid protocol'
  [[ "$source" == 'any' || "$source" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}(/[0-9]{1,2})?$ || "$source" =~ ^[0-9A-Fa-f:]+(/[0-9]{1,3})?$ ]] || fail 'Invalid source'
  if [[ "$source" == 'any' ]]; then
    /usr/sbin/ufw allow "$port/$protocol"
  else
    /usr/sbin/ufw allow from "$source" to any port "$port" proto "$protocol"
  fi
  printf 'Regla permitida: %s/%s desde %s\n' "$port" "$protocol" "$source"
  exit 0
fi
if [[ "$action" == 'server-firewall-delete' ]]; then
  (( $# == 2 )) || fail 'Rule number is required'
  [[ "$2" =~ ^[0-9]{1,3}$ && "$2" -ge 1 ]] || fail 'Invalid rule number'
  /usr/sbin/ufw --force delete "$2"
  printf 'Regla UFW eliminada: %s\n' "$2"
  exit 0
fi
if [[ "$action" == 'server-fail2ban-reload' ]]; then
  (( $# == 1 )) || fail 'This action does not accept arguments'
  systemctl restart fail2ban
  printf 'Fail2ban: %s\n' "$(systemctl is-active fail2ban)"
  exit 0
fi
if [[ "$action" == 'server-fail2ban-unban' ]]; then
  (( $# == 3 )) || fail 'Jail and IP are required'
  jail="$2"; ip="$3"
  [[ "$jail" =~ ^[A-Za-z0-9_-]{1,64}$ ]] || fail 'Invalid jail'
  [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ || "$ip" =~ ^[0-9A-Fa-f:]+$ ]] || fail 'Invalid IP'
  available_jails="$(/usr/bin/fail2ban-client status 2>/dev/null | awk -F: '/Jail list/ {gsub(/^[[:space:]]+/, "", $2); print $2}' | tr ',' '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  printf '%s\n' "$available_jails" | grep -Fxq "$jail" || fail 'Jail is not active'
  /usr/bin/fail2ban-client set "$jail" unbanip "$ip"
  printf 'IP desbloqueada: %s (%s)\n' "$ip" "$jail"
  exit 0
fi
if [[ "$action" == 'server-ssh-add-key' ]]; then
  (( $# == 2 )) || fail 'Public key is required'
  ssh_operator="$(getent passwd 1000 | cut -d: -f1)"; ssh_home="$(getent passwd 1000 | cut -d: -f6)"; public_key="$2"
  [[ -n "$ssh_operator" && -n "$ssh_home" ]] || fail 'SSH operator user is unavailable'
  [[ "$public_key" =~ ^(ssh-(ed25519|rsa)|ecdsa-sha2-nistp(256|384|521))[[:space:]][A-Za-z0-9+/=]+([[:space:]][^[:cntrl:]]+)?$ ]] || fail 'Invalid public key'
  printf '%s\n' "$public_key" | /usr/bin/ssh-keygen -lf - >/dev/null 2>&1 || fail 'Invalid public key'
  install -d -o "$ssh_operator" -g "$ssh_operator" -m 0700 "$ssh_home/.ssh"
  keys_file="$ssh_home/.ssh/authorized_keys"; touch "$keys_file"; chown "$ssh_operator:$ssh_operator" "$keys_file"; chmod 0600 "$keys_file"
  grep -Fxq "$public_key" "$keys_file" && fail 'Public key already exists'
  printf '%s\n' "$public_key" >> "$keys_file"
  echo 'Llave pública agregada al usuario SSH administrador'
  exit 0
fi
if [[ "$action" == 'server-ssh-delete-key' ]]; then
  (( $# == 2 )) || fail 'Key number is required'
  [[ "$2" =~ ^[0-9]{1,4}$ && "$2" -ge 1 ]] || fail 'Invalid key number'
  ssh_home="$(getent passwd 1000 | cut -d: -f6)"; keys_file="$ssh_home/.ssh/authorized_keys"
  [[ -f "$keys_file" ]] || fail 'No SSH keys are configured'
  key_count="$(grep -Ec '^[^#[:space:]]' "$keys_file" || true)"
  [[ "$key_count" -gt 1 ]] || fail 'Refusing to remove the only SSH key'
  sed -n "${2}p" "$keys_file" | grep -q '^[^#[:space:]]' || fail 'Key number is not available'
  sed -i "${2}d" "$keys_file"
  echo 'Llave pública eliminada'
  exit 0
fi
if [[ "$action" == 'server-system-update-start' ]]; then
  (( $# == 1 )) || fail 'This action does not accept arguments'
  systemctl is-active --quiet minipanel-system-update && fail 'A system update is already running'
  install -d -o root -g root -m 0750 /var/log/minipanel
  : > /var/log/minipanel/system-update.log
  systemd-run --unit=minipanel-system-update --collect --property=Type=exec --property=StandardOutput=append:/var/log/minipanel/system-update.log --property=StandardError=append:/var/log/minipanel/system-update.log /bin/bash -c 'set -eu; export DEBIAN_FRONTEND=noninteractive; apt-get update; apt-get -y upgrade; echo "System update completed: $(date -Is)"'
  echo 'Actualización iniciada en segundo plano. Revisa el estado en unos minutos.'
  exit 0
fi
if [[ "$action" == 'server-panel-update-start' ]]; then
  (( $# == 1 )) || fail 'This action does not accept arguments'
  systemctl is-active --quiet minipanel-panel-update && fail 'A Freyja update is already running'
  install -d -o root -g root -m 0750 /var/log/minipanel
  install -d -o root -g root -m 0700 /run/minipanel
  update_script=/run/minipanel/panel-update
  cat > "$update_script" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

storage_path="$(cat /etc/minipanel/panel-storage-path)"
app_path="${storage_path%/storage/app/private}"
panel_user="$(cat /etc/minipanel/panel-user)"
php_version="$(tr -d '[:space:]' < /etc/minipanel/panel-php-version 2>/dev/null || printf '8.3')"
[[ "$app_path" == /var/www/* && -d "$app_path/.git" ]] || { echo 'Panel Git checkout is unavailable' >&2; exit 64; }
[[ "$panel_user" =~ ^[a-z_][a-z0-9_-]{0,31}$ && "$php_version" =~ ^8\.[0-9]{1,2}$ ]] || { echo 'Panel runtime configuration is invalid' >&2; exit 64; }
git_user="$(stat -c '%U' "$app_path/.git")"
[[ "$git_user" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || { echo 'Panel Git identity is invalid' >&2; exit 64; }
git_home="$(getent passwd "$git_user" | cut -d: -f6)"
[[ "$git_home" == /home/* && -d "$git_home" ]] || { echo 'Panel Git home is invalid' >&2; exit 64; }
branch="$(runuser -u "$git_user" -- env "HOME=$git_home" git -C "$app_path" symbolic-ref --short HEAD)"
[[ "$branch" =~ ^[A-Za-z0-9._/-]+$ ]] || { echo 'Panel branch is invalid' >&2; exit 64; }
runuser -u "$git_user" -- env "HOME=$git_home" git -C "$app_path" fetch --prune origin "$branch"
git -c safe.directory="$app_path" -C "$app_path" reset --hard "origin/$branch"
install -o root -g root -m 0640 "$app_path/ops-agent/minipanel-database.php" /usr/local/lib/minipanel-database.php
install -o root -g root -m 0640 "$app_path/ops-agent/minipanel-database-operation.php" /usr/local/lib/minipanel-database-operation.php
install -o root -g root -m 0640 "$app_path/ops-agent/minipanel-site-lifecycle.php" /usr/local/lib/minipanel-site-lifecycle.php
install -o root -g root -m 0644 "$app_path/ops-agent/minipanel-git.php" /usr/local/lib/minipanel-git.php
install -o root -g root -m 0644 "$app_path/ops-agent/minipanel-snapshot.cjs" /usr/local/lib/minipanel-snapshot.cjs
install -o root -g root -m 0644 "$app_path/ops-agent/minipanel-extract.py" /usr/local/lib/minipanel-extract.py
install -o root -g root -m 0644 "$app_path/ops-agent/minipanel-root-terminal.service" /etc/systemd/system/minipanel-root-terminal.service
install -o root -g root -m 0644 "$app_path/ops-agent/minipanel-root-terminal.nginx.conf" /etc/nginx/snippets/minipanel-root-terminal.conf
install -o root -g root -m 0750 "$app_path/ops-agent/minipanel-agent" /usr/local/bin/minipanel-agent
COMPOSER_ALLOW_SUPERUSER=1 /usr/bin/php"$php_version" /usr/bin/composer install --no-dev --prefer-dist --optimize-autoloader --no-interaction --working-dir="$app_path"
npm --prefix "$app_path" ci --no-audit --no-fund
npm --prefix "$app_path" run build
chown -R root:root "$app_path/vendor" "$app_path/node_modules" "$app_path/public/build"
chmod -R a+rX "$app_path/vendor" "$app_path/node_modules" "$app_path/public/build"
runuser -u "$panel_user" -- /usr/bin/php"$php_version" "$app_path/artisan" migrate --force --no-interaction
runuser -u "$panel_user" -- /usr/bin/php"$php_version" "$app_path/artisan" optimize
systemctl daemon-reload
systemctl enable --now minipanel-root-terminal
nginx -t
systemctl reload nginx
systemctl restart "php$php_version-fpm" minipanel-worker
echo "Freyja updated from origin/$branch: $(git -c safe.directory="$app_path" -C "$app_path" rev-parse --short HEAD)"
EOF
  chown root:root "$update_script"
  chmod 0750 "$update_script"
  : > /var/log/minipanel/panel-update.log
  systemd-run --unit=minipanel-panel-update --collect --property=Type=exec --property=User=root --property=StandardOutput=append:/var/log/minipanel/panel-update.log --property=StandardError=append:/var/log/minipanel/panel-update.log /bin/bash "$update_script"
  echo 'Actualización de Freyja iniciada en segundo plano. El panel se recargará al terminar.'
  exit 0
fi
if [[ "$action" == 'server-panel-update-status' ]]; then
  (( $# == 1 )) || fail 'This action does not accept arguments'
  storage_path="$(cat /etc/minipanel/panel-storage-path)"
  app_path="${storage_path%/storage/app/private}"
  [[ "$app_path" == /var/www/* && -d "$app_path/.git" ]] || fail 'Panel Git checkout is unavailable'
  branch="$(git -c safe.directory="$app_path" -C "$app_path" symbolic-ref --short HEAD 2>/dev/null || printf 'detached')"
  commit="$(git -c safe.directory="$app_path" -C "$app_path" rev-parse --short HEAD)"
  committed_at="$(git -c safe.directory="$app_path" -C "$app_path" log -1 --format=%cI)"
  printf 'Rama\t%s\nCommit\t%s\nFecha\t%s\n' "$branch" "$commit" "$committed_at"
  exit 0
fi
if [[ "$action" == 'server-hostname' ]]; then
  (( $# == 2 )) || fail 'Hostname is required'
  hostname="$2"
  [[ "$hostname" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,}$ ]] || fail 'Invalid hostname'
  hostnamectl set-hostname "$hostname"
  printf 'Hostname actualizado: %s\n' "$(hostnamectl --static 2>/dev/null || hostname)"
  exit 0
fi
if [[ "$action" == 'server-timezone' ]]; then
  (( $# == 2 )) || fail 'Timezone is required'
  timezone="$2"
  [[ "$timezone" =~ ^[A-Za-z][A-Za-z0-9._+-]*/[A-Za-z0-9._+/-]+$ && -e "/usr/share/zoneinfo/$timezone" ]] || fail 'Invalid timezone'
  timedatectl set-timezone "$timezone"
  printf 'Zona horaria actualizada: %s\n' "$(timedatectl show --property=Timezone --value)"
  exit 0
fi
if [[ "$action" == 'server-sync-clock' ]]; then
  (( $# == 1 )) || fail 'This action does not accept arguments'
  timedatectl set-ntp true
  systemctl restart systemd-timesyncd
  echo 'Sincronización NTP habilitada'
  exit 0
fi
if [[ "$action" == 'server-restart-service' ]]; then
  (( $# == 2 )) || fail 'Service is required'
  case "$2" in nginx|"$panel_php_service"|mariadb|redis-server|minipanel-worker|minipanel-root-terminal) ;; *) fail 'Service is not managed by MiniPanel' ;; esac
  systemctl restart "$2"
  printf '%s: %s\n' "$2" "$(systemctl is-active "$2")"
  exit 0
fi
if [[ "$action" == 'server-service-log' ]]; then
  (( $# == 2 )) || fail 'Service is required'
  case "$2" in nginx|"$panel_php_service"|mariadb|redis-server|minipanel-worker|minipanel-root-terminal) ;; *) fail 'Service is not managed by MiniPanel' ;; esac
  /usr/bin/journalctl --unit "$2" --lines 80 --no-pager --output short-iso
  exit 0
fi
if [[ "$action" == 'server-reboot' ]]; then
  (( $# == 1 )) || fail 'This action does not accept arguments'
  systemctl reboot
  exit 0
fi
if [[ "$action" == 'import-mariadb-timezones' ]]; then
  (( $# == 1 )) || fail 'This action does not accept arguments'
  [[ -x /usr/bin/mariadb-tzinfo-to-sql && -x /usr/bin/mariadb && -x /usr/bin/mariadb-dump && -d /usr/share/zoneinfo ]] || fail 'MariaDB utilities or system zoneinfo are unavailable'
  exec 8>/run/lock/minipanel-mariadb-timezones.lock
  flock -n 8 || fail 'Timezone import already running'
  umask 077
  temporary_sql="$(mktemp /tmp/minipanel-timezones.XXXXXXXX.sql)"
  trap 'rm -f -- "$temporary_sql"' EXIT
  /usr/bin/timeout 15 /usr/bin/mariadb-tzinfo-to-sql /usr/share/zoneinfo > "$temporary_sql"
  [[ -s "$temporary_sql" ]] || fail 'No timezone data was generated'
  /usr/bin/timeout 5 /usr/bin/mariadb --no-defaults --protocol=socket --user=root --batch --skip-column-names -e 'SELECT COUNT(*) FROM mysql.time_zone_name' >/dev/null
  install -d -o root -g root -m 0700 /var/backups/minipanel-timezones
  backup_file="$(mktemp /var/backups/minipanel-timezones/before-import.XXXXXXXX.sql)"
  /usr/bin/timeout 15 /usr/bin/mariadb-dump --no-defaults --protocol=socket --user=root mysql time_zone time_zone_name time_zone_transition time_zone_transition_type time_zone_leap_second > "$backup_file"
  /usr/bin/timeout 30 /usr/bin/mariadb --no-defaults --protocol=socket --user=root mysql < "$temporary_sql"
  count="$(/usr/bin/timeout 5 /usr/bin/mariadb --no-defaults --protocol=socket --user=root --batch --skip-column-names -e 'SELECT COUNT(*) FROM mysql.time_zone_name')"
  [[ "$count" =~ ^[0-9]+$ && "$count" -gt 0 ]] || fail 'Timezone import could not be verified'
  printf 'Catálogo cargado: %s zonas horarias.\nRespaldo previo: %s\nNo se reinició MariaDB. Las zonas previamente almacenadas en caché requieren un reinicio programado.\n' "$count" "$backup_file"
  exit 0
fi
if [[ "$action" == 'configure-mariadb' ]]; then
  IFS= read -r database_host; IFS= read -r database_port; IFS= read -r database_user; IFS= read -r database_password
  [[ "$database_host" =~ ^[A-Za-z0-9._:-]+$ ]] || fail 'Invalid MariaDB host'
  [[ "$database_port" =~ ^[0-9]{2,5}$ ]] || fail 'Invalid MariaDB port'
  [[ "$database_user" =~ ^[A-Za-z0-9_]+$ ]] || fail 'Invalid MariaDB username'
  [[ "$database_password" != *$'\n'* ]] || fail 'Invalid MariaDB password'
  install -d -m 0700 -o root -g root /etc/minipanel
  umask 077
  { printf '[client]\nhost=%s\nport=%s\nuser=%s\npassword="%s"\n' "$database_host" "$database_port" "$database_user" "${database_password//\"/\\\"}"; } > /etc/minipanel/mariadb-provisioner.cnf
  chown root:root /etc/minipanel/mariadb-provisioner.cnf; chmod 0600 /etc/minipanel/mariadb-provisioner.cnf
  echo 'MariaDB provisioner configured'; exit 0
fi
case "$action" in file-extract|laravel-service|repository|site-lifecycle|snapshot|site-statistics|database-sync|configure-hosting|provision|deploy|issue-ssl|inspect|artisan|composer|npm|write-env|write-nginx-config|create-deploy-key|remove-deploy-key|backup|restore-backup|health|dns-check|logs|add-alias|remove-alias|restart-queue|rollback|configure-queue|remove-queue|suspend-site|resume-site|file-create|file-copy|file-compress|file-chmod|file-list|file-read|file-download|file-write|file-upload|file-mkdir|file-move|file-delete) ;; *) fail 'Action not allowed' ;; esac
[[ "$site_root" == "/var/www/$domain" ]] || fail 'Invalid site root'
[[ "$domain" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$ ]] || fail 'Invalid domain'
[[ "$branch" =~ ^[A-Za-z0-9._/-]+$ ]] || fail 'Invalid branch'
[[ "$php_version" =~ ^8\.[0-9]{1,2}$ ]] || fail 'Unsupported PHP version'
[[ "$queue_enabled" =~ ^[01]$ && "$scheduler_enabled" =~ ^[01]$ ]] || fail 'Invalid service setting'
[[ "$runtime" =~ ^(laravel|static)$ ]] || fail 'Invalid runtime'
[[ -z "$repository" || "$repository" =~ ^https://[^[:space:]]+$ || "$repository" =~ ^git@[A-Za-z0-9.-]+:[A-Za-z0-9._/-]+\.git$ || "$repository" =~ ^ssh://[^[:space:]]+$ ]] || fail 'Invalid repository URL'
(( ${#extra_arguments[@]} <= 20 )) || fail 'Too many arguments'
for argument in "${extra_arguments[@]}"; do (( ${#argument} <= 512 )) || fail 'Argument too long'; done

if [[ -f "$site_user_file" && ! -L "$site_user_file" ]]; then
  site_user="$(tr -d '[:space:]' < "$site_user_file")"
elif (( ${#legacy_site_user} <= 32 )); then
  site_user="$legacy_site_user"
else
  site_user="mp_$(printf '%s' "$domain" | sha256sum | cut -c1-20)"
fi
[[ "$site_user" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || fail 'Invalid site system user'

install -d -o root -g root -m 0700 /run/minipanel
exec 7>"/run/minipanel/lifecycle-$domain.lock"
if [[ "$action" == 'site-lifecycle' ]]; then
  flock -x -w 5 7 || fail 'Domain busy; wait for existing operations'
  exec 9>/run/lock/minipanel-nginx.lock
  flock -x -w 5 9 || fail 'Nginx busy'
  exec /usr/bin/php /usr/local/lib/minipanel-site-lifecycle.php "$domain" "${extra_arguments[0]:-}"
fi
flock -s -w 5 7 || fail 'Domain lifecycle operation in progress'
lifecycle_manifest="/var/lib/minipanel/site-trash/$domain/manifest.json"
if [[ -f "$lifecycle_manifest" ]]; then
  lifecycle_phase="$(/usr/bin/php -r 'echo json_decode(file_get_contents($argv[1]), true, flags: JSON_THROW_ON_ERROR)["phase"];' "$lifecycle_manifest")"
  if [[ "$action" == 'provision' && "$lifecycle_phase" == 'purged' ]]; then
    rm -- "$lifecycle_manifest"
    rmdir -- "/var/lib/minipanel/site-trash/$domain"
  else
    [[ "$lifecycle_phase" == 'restored' ]] || fail 'Domain is in trash or has an incomplete lifecycle operation'
  fi
fi
public_domain="$domain"
if [[ -f "/etc/minipanel/domain-names/$domain" ]]; then
  public_domain="$(cat "/etc/minipanel/domain-names/$domain")"
  [[ "$public_domain" =~ ^[a-z0-9.-]+$ ]] || fail 'Invalid public domain mapping'
fi
if [[ -f "$node_version_file" && ! -L "$node_version_file" ]]; then
  node_version="$(tr -d '[:space:]' < "$node_version_file")"
  [[ "$node_version" =~ ^[1-9][0-9]$ && "$node_version" -ge 18 ]] || fail 'Invalid configured Node.js version'
fi

if [[ -d "/var/lib/minipanel/suspended/$domain" ]]; then
  case "$action" in
    suspend-site|resume-site|inspect|logs|backup|health|dns-check|file-*) ;;
    *) fail 'Reactivate the suspended domain before changing its services or hosting' ;;
  esac
fi

if [[ "$action" == 'repository' ]]; then
  panel_identity="$(cat /etc/minipanel/panel-user)"
  [[ -d "$site_root" && ! -L "$site_root" && -f "$nginx_file" && ! -L "$nginx_file" ]] || fail 'Unknown domain'
  [[ "$(id -u "$site_user")" != 0 && "$(id -u "$site_user")" != "$(id -u "$panel_identity")" ]] || fail 'Invalid site identity'
  case "${extra_arguments[0]:-}" in key|folders|mkdir|sync|laravel-state|laravel-env-read|laravel-env-write|laravel-command|laravel-maintenance|laravel-puppeteer) ;; *) fail 'Invalid repository operation' ;; esac
  execution_timeout=20
  [[ "${extra_arguments[0]}" != sync ]] || execution_timeout=1680
  [[ "${extra_arguments[0]}" != laravel-command ]] || execution_timeout=840
  [[ "${extra_arguments[0]}" != laravel-puppeteer ]] || execution_timeout=1680
  ensure_node_runtime "$node_version"
  [[ "${extra_arguments[0]}" != laravel-puppeteer ]] || ensure_chrome_runtime
  exec /usr/bin/timeout --kill-after=5 "$execution_timeout" /usr/sbin/runuser -u "$site_user" -- /usr/bin/setpriv --no-new-privs /usr/bin/env -i "HOME=$site_root" "MINIPANEL_NPM_BINARY=$node_npm" PATH=/usr/local/bin:/usr/bin:/bin /usr/bin/php /usr/local/lib/minipanel-git.php "$site_root" "$php_version" "${extra_arguments[0]}"
fi

if [[ "$action" == 'snapshot' ]]; then
  [[ -f "$nginx_file" && ! -L "$nginx_file" ]] || fail 'Unknown site'
  [[ "${extra_arguments[0]:-}" =~ ^https?$ ]] || fail 'Invalid snapshot scheme'
  exec 8>/run/lock/minipanel-snapshot.lock
  flock -w 5 8 || fail 'Snapshot busy'
  exec systemd-run --quiet --wait --pipe --collect -p DynamicUser=yes -p PrivateTmp=yes -p ProtectSystem=strict -p ProtectHome=yes -p NoNewPrivileges=yes -p 'InaccessiblePaths=/var/www /etc/minipanel /var/lib/minipanel' -p IPAddressDeny=any -p IPAddressAllow=localhost -p MemoryMax=768M -p TasksMax=128 -p RuntimeMaxSec=45 --setenv=PLAYWRIGHT_BROWSERS_PATH=/opt/minipanel-snapshots/browsers /usr/bin/node /usr/local/lib/minipanel-snapshot.cjs "$public_domain" "${extra_arguments[0]}"
fi

safe_relative_path() {
  local input="${1:-}" part normalized='' IFS='/'
  input="${input#/}"; input="${input%/}"
  [[ -n "$input" && "$input" != '.' ]] || { printf '.'; return; }
  read -r -a parts <<< "$input"
  for part in "${parts[@]}"; do
    [[ "$part" =~ ^([A-Za-z0-9][A-Za-z0-9._\ -]{0,127}|\.[A-Za-z0-9][A-Za-z0-9._\ -]{0,126})$ && "$part" != '.' && "$part" != '..' && "$part" != '.git' && "$part" != '.ssh' ]] || fail 'Invalid file path'
    normalized+="${normalized:+/}$part"
  done
  printf '%s' "$normalized"
}

safe_site_path() {
  local relative current part IFS='/'
  relative="$(safe_relative_path "${1:-}")"
  [[ -d "$site_root" && ! -L "$site_root" ]] || fail 'Site root is unavailable'
  current="$site_root"
  if [[ "$relative" != '.' ]]; then
    read -r -a parts <<< "$relative"
    for part in "${parts[@]}"; do
      current+="/$part"
      [[ ! -L "$current" ]] || fail 'Symbolic links are not supported by File Manager'
    done
  fi
  printf '%s' "$current"
}

configure_site_pool() {
  local version="$1" memory_limit="${2:-256M}" execution_timeout="${3:-120}" upload_limit="${4:-2g}" pool_file="/etc/php/$1/fpm/pool.d/minipanel-$domain.conf"
  [[ -d "/etc/php/$version/fpm/pool.d" ]] || fail 'PHP-FPM is not installed'
  [[ ! -L "$pool_file" ]] || fail 'Unexpected pool link'
  id "$site_user" >/dev/null || fail 'Unknown site user'
  if id -nG "$site_user" | tr ' ' '\n' | grep -qx www-data; then
    gpasswd -d "$site_user" www-data
  fi
  cat > "$pool_file" <<EOF
[minipanel-$domain]
user = $site_user
group = $(id -gn "$site_user")
listen = /run/php/minipanel-$domain-$version.sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660
pm = ondemand
pm.max_children = 5
pm.process_idle_timeout = 10s
clear_env = yes
security.limit_extensions = .php
php_admin_value[memory_limit] = $memory_limit
php_admin_value[max_execution_time] = $execution_timeout
php_admin_value[max_input_time] = $execution_timeout
php_admin_value[upload_max_filesize] = $upload_limit
php_admin_value[post_max_size] = $upload_limit
EOF
  chown root:root "$pool_file"; chmod 0644 "$pool_file"
  "/usr/sbin/php-fpm$version" -t
  systemctl reload "php$version-fpm"
}

ensure_php_repository() {
  local version="$1" launchpad_home='/var/lib/minipanel/launchpadlib'

  apt-cache show "php${version}-fpm" >/dev/null 2>&1 && return 0

  echo "PHP $version no está disponible en los repositorios actuales; habilitando el repositorio de PHP…"
  if ! command -v add-apt-repository >/dev/null 2>&1; then
    DEBIAN_FRONTEND=noninteractive apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y software-properties-common
  fi
  install -d -m 0700 -o root -g root "$launchpad_home"
  HOME="$launchpad_home" XDG_CACHE_HOME="$launchpad_home" add-apt-repository -y ppa:ondrej/php
  DEBIAN_FRONTEND=noninteractive apt-get update
  apt-cache show "php${version}-fpm" >/dev/null 2>&1 || fail "PHP $version is unavailable for this server"
}

ensure_php_runtime() {
  local version="$1"

  [[ "$version" =~ ^8\.[0-9]{1,2}$ ]] || fail 'Unsupported PHP version'
  if [[ ! -x "/usr/sbin/php-fpm$version" ]]; then
    echo "Instalando PHP $version, PHP-FPM y el stack Laravel…"
    ensure_php_repository "$version"
  else
    echo "Verificando el stack Laravel de PHP $version…"
  fi

  DEBIAN_FRONTEND=noninteractive apt-get install -y \
    "php${version}-cli" \
    "php${version}-fpm" \
    "php${version}-common" \
    "php${version}-opcache" \
    "php${version}-bcmath" \
    "php${version}-curl" \
    "php${version}-gd" \
    "php${version}-intl" \
    "php${version}-mbstring" \
    "php${version}-mysql" \
    "php${version}-redis" \
    "php${version}-soap" \
    "php${version}-xml" \
    "php${version}-zip"
  systemctl enable --now "php${version}-fpm"
}

composer_as_site() {
  [[ -x "/usr/bin/php$php_version" && -f /usr/bin/composer ]] || fail 'Composer or the selected PHP CLI is unavailable'

  sudo -u "$site_user" "/usr/bin/php$php_version" /usr/bin/composer --working-dir="$site_root" "$@"
}

create_services() {
  systemctl daemon-reload
  if [[ "$queue_enabled" == '1' ]]; then
    cat > "$service_file" <<EOF
[Unit]
Description=MiniPanel Laravel queue for $domain
After=network.target
[Service]
Type=simple
User=$site_user
WorkingDirectory=$site_root
ExecStart=/usr/bin/php$php_version artisan queue:work --sleep=3 --tries=3 --max-time=3600
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
EOF
    systemctl daemon-reload
    systemctl enable --now "minipanel-${domain}.service"
  fi
  if [[ "$scheduler_enabled" == '1' ]]; then
    cat > "$timer_file" <<EOF
[Unit]
Description=MiniPanel scheduler for $domain
[Timer]
OnCalendar=*:*:00
Persistent=true
[Install]
WantedBy=timers.target
EOF
    cat > "/etc/systemd/system/minipanel-${domain}-schedule.service" <<EOF
[Service]
Type=oneshot
User=$site_user
WorkingDirectory=$site_root
ExecStart=/usr/bin/php$php_version artisan schedule:run --no-interaction
EOF
    systemctl daemon-reload
    systemctl enable --now "minipanel-${domain}.timer"
  fi
}

ensure_php_extensions() {
  local version="${1:-$php_version}"

  [[ "$runtime" == 'laravel' ]] || return 0
  local packages=() extension package
  IFS=',' read -r -a extensions <<< "$php_extensions"
  for extension in "${extensions[@]}"; do
    [[ -z "$extension" ]] && continue
    case "$extension" in bcmath|curl|mbstring|mysql|xml|zip|gd|intl|redis|soap|imagick) ;; *) fail "PHP extension not allowed: $extension" ;; esac
    package="$extension"; [[ "$extension" == 'xml' ]] && package='xml'
    packages+=("php${version}-${package}")
  done
  (( ${#packages[@]} > 0 )) || return 0
  DEBIAN_FRONTEND=noninteractive apt-get install -y "${packages[@]}"
  systemctl restart "php${version}-fpm"
}

git_as_site() {
  if [[ -f "$key_file" ]]; then
    install -d -m 0700 -o "$site_user" -g "$site_user" "$site_root/.ssh"
    chmod 0711 /etc/minipanel "$key_directory"
    sudo -u "$site_user" env "HOME=$site_root" "GIT_SSH_COMMAND=ssh -i $key_file -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=$site_root/.ssh/known_hosts" git "$@"
  else
    sudo -u "$site_user" git "$@"
  fi
}

update_server_names() {
  install -d -m 0755 -o root -g root /etc/minipanel/aliases
  local aliases=''
  [[ -f "$alias_file" ]] && aliases=" $(tr '\n' ' ' < "$alias_file")"
  sed -i -E "s|^[[:space:]]*server_name .*;|    server_name $public_domain$aliases;|" "$nginx_file"
  nginx -t && systemctl reload nginx
}

stop_site_services() {
  systemctl stop "minipanel-${domain}.service" "minipanel-${domain}.timer" 2>/dev/null || true
  local unit
  for unit in /etc/systemd/system/minipanel-"$domain"-queue-*.timer /etc/systemd/system/minipanel-"$domain"-queue-*.service; do
    [[ -e "$unit" ]] || continue
    systemctl stop "$(basename "$unit")" 2>/dev/null || true
  done
}

restore_site_services() {
  local unit
  [[ -f "$service_file" ]] && systemctl start "minipanel-${domain}.service" 2>/dev/null || true
  [[ -f "$timer_file" ]] && systemctl start "minipanel-${domain}.timer" 2>/dev/null || true
  for unit in /etc/systemd/system/minipanel-"$domain"-queue-*.service; do
    [[ -e "$unit" ]] || continue
    if systemctl is-enabled --quiet "$(basename "$unit")"; then
      systemctl start "$(basename "$unit")" 2>/dev/null || true
    fi
  done
  for unit in /etc/systemd/system/minipanel-"$domain"-queue-*.timer; do
    [[ -e "$unit" ]] || continue
    if systemctl is-enabled --quiet "$(basename "$unit")"; then
      systemctl start "$(basename "$unit")" 2>/dev/null || true
    fi
  done
}

restore_laravel_site() {
  [[ -f "$site_root/artisan" ]] && sudo -u "$site_user" "/usr/bin/php$php_version" "$site_root/artisan" up --no-interaction 2>/dev/null || true
  restore_site_services
}

run_post_deploy_commands() {
  local line command
  local -a command_parts

  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ "$line" =~ ^(php\ artisan|composer|npm)([[:space:]]+[A-Za-z0-9_.,:@=+/-]+)*$ ]] || fail 'Invalid post-deploy command'

    IFS=' ' read -r -a command_parts <<< "$line"
    (( ${#command_parts[@]} >= 2 )) || fail 'Post-deploy command requires an action'
    echo "+ $line"
    case "${command_parts[0]}" in
      php)
        [[ "${command_parts[1]:-}" == 'artisan' && -f "$site_root/artisan" ]] || fail 'Laravel Artisan is unavailable'
        sudo -u "$site_user" "/usr/bin/php$php_version" "$site_root/artisan" "${command_parts[@]:2}"
        ;;
      composer)
        composer_as_site "${command_parts[@]:1}"
        ;;
      npm)
        npm_as_site "${command_parts[@]:1}"
        ;;
    esac
  done
}

provision_site() {
  install -d -m 0755 -o root -g root "$site_user_directory"
  if [[ ! -e "$site_user_file" ]]; then
    printf '%s\n' "$site_user" > "$site_user_file"
    chown root:root "$site_user_file"
    chmod 0644 "$site_user_file"
  fi
  ensure_php_runtime "$php_version"
  ensure_php_extensions "$php_version"
  save_node_version "$node_version"
  id "$site_user" &>/dev/null || useradd --system --user-group --no-create-home --shell /usr/sbin/nologin "$site_user"
  install -d -o "$site_user" -g www-data -m 0750 "$site_root"
  configure_site_pool "$php_version"
  if [[ ! -f "$nginx_file" ]]; then
    [[ ! -L "$site_root/httpdocs" ]] || fail 'Unexpected document root link'
    install -d -o "$site_user" -g www-data -m 0750 "$site_root/httpdocs"
  fi

  if [[ ! -f "$nginx_file" ]]; then
    install -d -m 0755 -o root -g root /etc/nginx/snippets
    : > "$nginx_snippet"; chown root:root "$nginx_snippet"; chmod 0644 "$nginx_snippet"
    cat > "$nginx_file" <<EOF
server {
    listen 80;
    listen [::]:80;
    server_name $public_domain;
    access_log /var/log/nginx/minipanel-$domain.access.log combined;
    root $site_root/httpdocs;
    index index.php index.html;
    client_max_body_size 2g;
    location / { try_files \$uri \$uri/ /index.php?\$query_string; }
    location ~ \\.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/minipanel-$domain-$php_version.sock;
    }
    location ~ /\\. { deny all; }
    include $nginx_snippet;
}
EOF
    ln -sfn "$nginx_file" "/etc/nginx/sites-enabled/$domain"
    nginx -t && systemctl reload nginx
  fi

  systemctl daemon-reload
}

case "$action" in
  site-statistics)
    [[ -d "$site_root" && ! -L "$site_root" && -f "$nginx_file" && ! -L "$nginx_file" ]] || fail 'Unknown domain'
    disk_bytes="$(du -sb -- "$site_root" 2>/dev/null | awk '{print $1}')"
    [[ "$disk_bytes" =~ ^[0-9]+$ ]] || fail 'Could not calculate site disk usage'
