      fail 'Could not apply suspended website configuration; snapshot retained'
    fi
    while IFS=$'\t' read -r unit enabled active; do
      systemctl disable --now "$unit"
    done < "$state_directory/services"
    usermod --expiredate 1 "$site_user"
    echo "Site suspended: $domain. Files and databases preserved."
    ;;
  resume-site)
    exec 9>/run/lock/minipanel-nginx.lock
    flock -x 9
    state_directory="/var/lib/minipanel/suspended/$domain"
    [[ -f "$state_directory/nginx" && -f "$state_directory/services" && -f "$state_directory/account-expiry" ]] || fail 'Suspension snapshot is unavailable'
    cp -p "$state_directory/nginx" "$nginx_file"
    if ! nginx -t || ! systemctl reload nginx; then
      sed '/^[[:space:]]*server[[:space:]]*{/a\    return 503 "Sitio suspendido";' "$state_directory/nginx" > "$nginx_file"
      fail 'Could not restore website configuration; snapshot retained'
    fi
