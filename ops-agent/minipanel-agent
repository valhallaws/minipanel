    done < "$state_directory/services"
    expiry="$(cat "$state_directory/account-expiry")"
    usermod --expiredate "$expiry" "$site_user"
    rm -f "$state_directory/nginx" "$state_directory/services" "$state_directory/account-expiry"
    rmdir "$state_directory"
    echo "Site resumed with previous service state: $domain"
    ;;
  delete-site)
    [[ "${extra_arguments[0]:-}" == "ELIMINAR $domain" ]] || fail 'Deletion confirmation does not match'
    [[ "$site_root" == "/var/www/$domain" ]] || fail 'Unsafe deletion target'
    db_name=''; db_user=''
    if [[ -f "$site_root/.env" ]]; then db_name="$(sed -nE 's/^DB_DATABASE=([^[:space:]]+).*$/\1/p' "$site_root/.env" | head -n1 | tr -d "'\"")"; db_user="$(sed -nE 's/^DB_USERNAME=([^[:space:]]+).*$/\1/p' "$site_root/.env" | head -n1 | tr -d "'\"")"; fi
