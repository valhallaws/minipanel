    ;;
  file-create)
    relative_path="$(safe_relative_path "${extra_arguments[0]:-}")"
    [[ "$relative_path" != '.' ]] || fail 'Select a file name'
    target_path="$(safe_site_path "$relative_path")"
    [[ ! -e "$target_path" && -d "$(dirname "$target_path")" ]] || fail 'File already exists or parent is missing'
    sudo -u "$site_user" bash -c 'set -euo pipefail; set -C; umask 027; : > "$1"' _ "$target_path"
    echo 'File created'
    ;;
  file-chmod)
    relative_path="$(safe_relative_path "${extra_arguments[0]:-}")"
    mode="${extra_arguments[1]:-}"
    [[ "$relative_path" != '.' && "$mode" =~ ^[0-7]{3}$ ]] || fail 'Invalid permission mode'
    target_path="$(safe_site_path "$relative_path")"
    [[ -e "$target_path" ]] || fail 'File does not exist'
    sudo -u "$site_user" chmod -- "$mode" "$target_path"
    echo 'Permissions updated'
    ;;
  file-copy|file-compress)
    source_relative="$(safe_relative_path "${extra_arguments[0]:-}")"
    destination_relative="$(safe_relative_path "${extra_arguments[1]:-}")"
    [[ "$source_relative" != '.' && "$destination_relative" != '.' ]] || fail 'Select source and destination'
    source_path="$(safe_site_path "$source_relative")"; destination_path="$(safe_site_path "$destination_relative")"
    [[ -e "$source_path" && ! -e "$destination_path" && -d "$(dirname "$destination_path")" ]] || fail 'Invalid source or destination, or destination already exists'
    [[ "$destination_path" != "$source_path/"* ]] || fail 'Destination cannot be inside the source'
    blocked_path="$(sudo -u "$site_user" find "$source_path" '(' -type l -o -name .git -o -name .ssh ')' -print -quit)"
    [[ -z "$blocked_path" ]] || fail 'Source contains symbolic links or protected directories'
    if [[ "$action" == 'file-copy' ]]; then
      sudo -u "$site_user" cp -R --no-clobber -- "$source_path" "$destination_path"
    else
      [[ "$destination_relative" == *.tar.gz ]] || fail 'Archive name must end in .tar.gz'
      sudo -u "$site_user" bash -c 'set -euo pipefail; set -C; umask 027; tar -czf - -C "$1" -- "$2" > "$3"' _ "$(dirname "$source_path")" "$(basename "$source_path")" "$destination_path"
    fi
    echo 'Operation completed'
    ;;
  file-mkdir)
    relative_path="$(safe_relative_path "${extra_arguments[0]:-}")"
    [[ "$relative_path" != '.' ]] || fail 'Select a folder name'
    target_path="$(safe_site_path "$relative_path")"
    [[ ! -e "$target_path" && -d "$(dirname "$target_path")" ]] || fail 'Folder already exists or parent is missing'
    sudo -u "$site_user" mkdir -- "$target_path"
    echo 'Folder created'
    ;;
  file-move)
    source_relative="$(safe_relative_path "${extra_arguments[0]:-}")"
    destination_relative="$(safe_relative_path "${extra_arguments[1]:-}")"
    [[ "$source_relative" != '.' && "$destination_relative" != '.' ]] || fail 'Select source and destination'
    source_path="$(safe_site_path "$source_relative")"; destination_path="$(safe_site_path "$destination_relative")"
    [[ -e "$source_path" && ! -L "$source_path" && ! -e "$destination_path" && -d "$(dirname "$destination_path")" ]] || fail 'Source or destination is not valid'
    sudo -u "$site_user" mv -- "$source_path" "$destination_path"
    echo 'File moved'
    ;;
  file-delete)
    relative_path="$(safe_relative_path "${extra_arguments[0]:-}")"
    [[ "$relative_path" != '.' ]] || fail 'Root directory cannot be deleted'
    target_path="$(safe_site_path "$relative_path")"
    [[ -e "$target_path" && ! -L "$target_path" ]] || fail 'File or folder does not exist'
    sudo -u "$site_user" rm -rf -- "$target_path"
    echo 'File deleted'
    ;;
  health)
    health_url="${extra_arguments[0]:-}"
    [[ "$health_url" =~ ^https?://[A-Za-z0-9.-]+([/:?#][^[:space:]]*)?$ ]] || fail 'Invalid health URL'
    curl --fail --show-error --silent --location --max-time 15 --output /dev/null --write-out 'HTTP %{http_code}' "$health_url"
    ;;
  dns-check)
    command -v dig >/dev/null || { echo 'Install dnsutils to use DNS propagation checks.' >&2; exit 69; }
    printf '{"domain":"%s","checks":[' "$public_domain"
    first=1
    for resolver in 1.1.1.1 8.8.8.8 9.9.9.9; do
      [[ "$first" == 1 ]] || printf ','; first=0
      ipv4="$(dig @"$resolver" +time=2 +tries=1 +short A "$public_domain" | paste -sd ' ' -)"
      ipv6="$(dig @"$resolver" +time=2 +tries=1 +short AAAA "$public_domain" | paste -sd ' ' -)"
      printf '{"resolver":"%s","a":"%s","aaaa":"%s"}' "$resolver" "$ipv4" "$ipv6"
    done
    printf ']}'
    ;;
  logs)
    case "${extra_arguments[0]:-}" in
      laravel) tail -n 250 "$site_root/storage/logs/laravel.log" ;;
      nginx-access) tail -n 250 /var/log/nginx/access.log ;;
      nginx-error) tail -n 250 /var/log/nginx/error.log ;;
      queue) journalctl -u "minipanel-${domain}.service" -n 250 --no-pager ;;
      *) fail 'Log target not allowed' ;;
    esac
    ;;
  add-alias)
    alias="${extra_arguments[0]:-}"
    [[ "$alias" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$ ]] || fail 'Invalid alias'
    install -d -m 0755 -o root -g root /etc/minipanel/aliases
    touch "$alias_file"; grep -qxF "$alias" "$alias_file" || echo "$alias" >> "$alias_file"
    update_server_names; echo "Alias added: $alias"
    ;;
  remove-alias)
    alias="${extra_arguments[0]:-}"
    [[ "$alias" =~ ^[a-z0-9.-]+\.[a-z]{2,}$ ]] || fail 'Invalid alias'
    [[ -f "$alias_file" ]] && sed -i "/^$alias$/d" "$alias_file" || true
    update_server_names; echo "Alias removed: $alias"
    ;;
  restart-queue)
    systemctl restart "minipanel-${domain}.service"
    echo 'Queue worker restarted'
    ;;
  configure-queue)
    queue_name="${extra_arguments[0]:-}"; workers="${extra_arguments[1]:-}"; tries="${extra_arguments[2]:-}"; timeout="${extra_arguments[3]:-}"
    [[ "$queue_name" =~ ^[A-Za-z0-9_-]{1,50}$ ]] || fail 'Invalid queue name'
    [[ "$workers" =~ ^([1-9]|1[0-2])$ ]] || fail 'Invalid worker count'
    [[ "$tries" =~ ^([1-9]|1[0-9]|20)$ ]] || fail 'Invalid tries'
    [[ "$timeout" =~ ^[0-9]{2,4}$ ]] || fail 'Invalid timeout'
    for worker in $(seq 1 "$workers"); do
      queue_service="/etc/systemd/system/minipanel-${domain}-queue-${queue_name}-${worker}.service"
      cat > "$queue_service" <<EOF
[Unit]
Description=MiniPanel queue $queue_name worker $worker for $domain
After=network.target
[Service]
Type=simple
User=$site_user
WorkingDirectory=$site_root
ExecStart=/usr/bin/php$php_version artisan queue:work --queue=$queue_name --sleep=3 --tries=$tries --timeout=$timeout --max-time=3600
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
EOF
    done
    systemctl daemon-reload
    for worker in $(seq 1 "$workers"); do systemctl enable --now "minipanel-${domain}-queue-${queue_name}-${worker}.service"; done
    echo "Queue $queue_name configured with $workers worker(s)"
    ;;
  remove-queue)
    queue_name="${extra_arguments[0]:-}"; workers="${extra_arguments[1]:-}"
    [[ "$queue_name" =~ ^[A-Za-z0-9_-]{1,50}$ && "$workers" =~ ^([1-9]|1[0-2])$ ]] || fail 'Invalid queue configuration'
    for worker in $(seq 1 "$workers"); do systemctl disable --now "minipanel-${domain}-queue-${queue_name}-${worker}.service" 2>/dev/null || true; rm -f "/etc/systemd/system/minipanel-${domain}-queue-${queue_name}-${worker}.service"; done
    systemctl daemon-reload; echo "Queue $queue_name removed"
    ;;
  suspend-site)
    exec 9>/run/lock/minipanel-nginx.lock
    flock -x 9
    state_directory="/var/lib/minipanel/suspended/$domain"
    install -d -m 0700 -o root -g root /var/lib/minipanel/suspended
    if [[ ! -d "$state_directory" ]]; then
      [[ -f "$nginx_file" && ! -L "$nginx_file" ]] || fail 'Nginx configuration is unavailable'
      id "$site_user" >/dev/null 2>&1 || fail 'Domain system user is unavailable'
      snapshot="$(mktemp -d /var/lib/minipanel/suspended/.snapshot-XXXXXXXX)"
      cp -p "$nginx_file" "$snapshot/nginx"
      getent shadow "$site_user" | cut -d: -f8 > "$snapshot/account-expiry"
      : > "$snapshot/services"
      while read -r unit _; do
        [[ "$unit" == "minipanel-${domain}.service" || "$unit" == "minipanel-${domain}.timer" || "$unit" == minipanel-"${domain}"-queue-*.service || "$unit" == minipanel-"${domain}"-queue-*.timer ]] || continue
        enabled="$(systemctl is-enabled "$unit" 2>/dev/null || true)"
        active="$(systemctl is-active "$unit" 2>/dev/null || true)"
