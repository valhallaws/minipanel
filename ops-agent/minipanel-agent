  rollback)
    commit="${extra_arguments[0]:-}"
    [[ "$commit" =~ ^[a-f0-9]{7,64}$ ]] || fail 'Invalid commit'
    git_as_site -C "$site_root" reset --hard "$commit"
    [[ "$runtime" == 'laravel' ]] && sudo -u "$site_user" /usr/bin/php$php_version "$site_root/artisan" optimize || npm_as_site run build
    echo "Rolled back to $commit"
    ;;
esac
